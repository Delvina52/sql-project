

 

--TopRevenueVendors: Calculate the total revenue (quantity * cost_to_customer_per_qty)for each vendor.
--Assign a rank to vendors based  on thisrevenue(Highest=1). Ensurethat ties share the same rank and no rank numbers are skipped in the sequence


sELECT
v.vendor_name,
SUM(cp.quantity * cp.cost_to_customer_per_qty) as total_revenue,
DENSE_RANK() OVER (ORDER BY SUM(cp.quantity * cp.cost_to_customer_per_qty) DESC)
as revenue_rank
FROM vendor v
JOIN customer_purchases cp ON v.vendor_id = cp.vendor_id
GROUP BY v.vendor_name;


--Latest PurchaseperCustomer: Retrievethesingle mostrecent purchase transaction forevery customer.
-- If a customer made multiple purchases at the exact same time on the same day, pick the one with the highest product_id.


SELECT * FROM (
SELECT
customer_id,
market_date,
transaction_time,
product_id,
ROW_NUMBER() OVER (
PARTITION BY customer_id
ORDER BY market_date DESC, transaction_time DESC, product_id DESC
) as rn
FROM customer_purchases
) x
WHERE rn = 1



--Running Total of Sales: Calculate the running total of sales (quantity * cost) for each customer, 
--ordered by transaction time. Reset the running total for each customer.

SELECT
 customer_id,
 market_date,
 transaction_time,
 (quantity * cost_to_customer_per_qty) as transaction_value,
 SUM(quantity * cost_to_customer_per_qty) OVER (
 PARTITION BY customer_id
8ORDER BY market_date, transaction_time
 ) as running_total
 FROM customer_purchases;




--Rolling 7-Day Average: Calculate the 7-day rolling average of total daily market revenue.

 WITH DailySales AS (
    SELECT market_date, 
           SUM(quantity * cost_to_customer_per_qty) AS daily_total
    FROM customer_purchases
    GROUP BY market_date
)
SELECT 
    market_date,
    daily_total,
    AVG(daily_total) OVER (
        ORDER BY market_date
        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
    ) AS rolling_7_day_avg
FROM DailySales;